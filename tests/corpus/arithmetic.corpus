# basic arithmetic
1 + 1                       => 2
1 + 1 + 1                   => 3
1 - 1                       => 0
1 - 5                       => -4
5 * 5                       => 25
5 / 5                       => 1
5 / 2                       => 2.5
5 % 2                       => 1
6 % 2                       => 0
2 ^ 8                       => 256
1.2 + 2.5                   => 3.7

# operator word aliases
6 mod 2                     => 0
6 modulo 2                  => 0
5 mul 5                     => 25
5 * 5 mul 10                => 250
5 * (5 mul 10 + 1)          => 255
5 div 5                     => 1
100 div 10 / 2              => 5
2 pow 8                     => 256
2 power 8                   => 256

# precedence
1 + 2 * 4                   => 9
(1 + 2) * 4                 => 12
((1 + 2) * 4) / 2           => 6
(1 + 2) * 4 / 2             => 6

# whitespace does not matter
1+1                         => 2
(1+1)/2                     => 1
((1+1)/2)*2                 => 2

# unary minus/plus
-1                          => -1
-1 + -1                     => -2
-1 - 1                      => -2
-1 + - 1                    => -2
--(2^8)                     => 256
-(150 * 2 / 2 + 1)          => -151
--++ ++ ++++++ - -123 + 1   => 124

# implicit multiplication
2(1+5)                      => 12
2 (1 + 5)                   => 12
2^2(1+5)                    => 24
2 ^ 2 (1 + 5)               => 24
(1+5)2                      => 12
( 1 + 5 ) 2                 => 12
( 1 + 5 ) 2^2               => 24
( 1 + 5 ) (1+1+1+1)         => 24

# an operator glued to a following '(' reads the same as the spaced form
2*(3)                       => 6
5*(3+4)                     => 35
2*(3)*4                     => 24
(2)*(3)                     => 6
2*(3)^2                     => 18
2<(3)                       => true
2>(3)                       => false
2==(3)                      => false
1!=(3)                      => true
2<<(3)                      => 16
2**(3)                      => 8

# juxtaposition binds like '*', so a trailing '^' applies to the factor
5^3-2(25)-13(5)-10          => 0
10-2(3)                     => 4
2+2(3)                      => 8
2(3)^2                      => 18

# functions
min(1, 5)                   => 1
max(1, 5)                   => 5
max(min(1, 10),max(1, 5))   => 5

# number bases
0xFF                        => 255
0xFF + 10 + 0xA             => 275
0o777                       => 511
0b10                        => 2
0b1111                      => 15
0b1111 * 0xF + 0o777 - 36   => 700

# output formats
256 to hex                  => 0x100
256 to binary               => 0b100000000
0xFF to dec                 => 255
0xFF to decimal             => 255

# bitwise
1 << 8                      => 256
1 << 16                     => 65,536
256 >> 1                    => 128
256 >> 2                    => 64

# percentages
20% of 100                  => 20
20% of 100 * 2              => 40
(20% of 100) * 2            => 40
(10 + 10)% of 100 + 2       => 22
40% of 10^2                 => 40

# constants
pi                          => 3.141593

# thousand separators: results are always grouped US-style, and both input
# styles read back, so any output can be pasted back in as input
1_000_000 + 1_000           => 1,001,000
1,000,000 + 1,000           => 1,001,000
1,001,000 / 2               => 500,500
999                         => 999
-1234567.891                => -1,234,567.891

# left-associativity of same-precedence operators
10 - 3 - 2                  => 5
100 - 10 - 10 - 10          => 70
100 / 5 / 2                 => 10
100 / 10 * 10               => 100
6 / 3 * 2                   => 4
1 - 2 + 3                   => 2
10 - 2 + 3                  => 11
10 - (2 + 3)                => 5

# exponentiation is right-associative
2 ^ 3 ^ 2                   => 512
2 ^ 2 ^ 3                   => 256
4 ^ 3 ^ 0                   => 4

# exponentiation binds tighter than unary minus
-2^2                        => -4
-3^2                        => -9
(-3)^2                      => 9
(-2)^3                      => -8

# exponent operand may be parenthesized, negative or fractional
2 ^ (3)                     => 8
2 ^ (2 + 1)                 => 8
2 ^ (6 / 2)                 => 8
16 ^ (0.5)                  => 4
27 ^ (1/3)                  => 3
2 ^ -1                      => 0.5
2 ^ -2                      => 0.25
2 ^ 0                       => 1
0 ^ 0                       => 1
0 ^ 5                       => 0
1 ^ 100                     => 1
10 ^ 3                      => 1,000

# more precedence
2 + 3 * 4 - 6 / 3           => 12
(2 + 3) * (4 - 6) / 2       => -5
1 + 1 * 2 ^ 2               => 5
2 ^ 2 * 3                   => 12
3 * 2 ^ 2                   => 12
100 / (10 * 10)             => 1
2 * 10 % 3                  => 2
10 % 3 * 2                  => 2

# modulo keeps the fractional part
7.5 % 2                     => 1.5
5.5 % 2.5                   => 0.5
10.5 % 3                    => 1.5

# modulo takes the sign of the left operand
-7 % 3                      => -1
7 % -3                      => 1

# division by zero must not surface inf/nan to the user
1 / 0                       => !error Division by zero
-1 / 0                      => !error Division by zero
0 / 0                       => !error Division by zero
5 % 0                       => !error Modulo by zero
1 / (2 - 2)                 => !error Division by zero
10 / 0.0                    => !error Division by zero

# a nan reaching the output is an error wherever it came from
(-1) ^ 0.5                  => !error Result is undefined
(-8) ^ 0.5                  => !error Result is undefined

# a result wider than 40 digits is shown in scientific notation
2 ^ 1000                    => 1.071509e+301
2 ^ 100                     => 1,267,650,600,228,229,401,496,703,205,376
1e39                        => 999,999,999,999,999,939,709,166,371,603,178,586,112
1e40                        => 1.000000e+40
1e300                       => 1.000000e+300
10 ^ 308                    => 1.000000e+308
2 ^ 0.5                     => 1.414214

# arithmetic is done in a double, so it tops out around 1e308 and overflow
# shows as inf rather than being reported
10 ^ 400                    => inf
10 ^ 5000                   => inf
2 ^ 20000                   => inf
10 ^ 5000.5                 => inf
-1 * 10 ^ 400               => -inf

# and once both sides are infinite the result is genuinely undefined
10 ^ 400 / 10 ^ 399         => !error Result is undefined

# the same ceiling limits how many digits survive
2 ^ 64                      => 18,446,744,073,709,551,616
2 ^ 64 + 1                  => 18,446,744,073,709,551,616
123456789012345678 + 1      => 123,456,789,012,345,696

# scientific notation, 'e' is an exponent marker when glued to digits
1e3                         => 1,000
1E3                         => 1,000
1e0                         => 1
1e-3                        => 0.001
1.5e3                       => 1,500
2.5e-2                      => 0.025
1e3 + 1                     => 1,001
2e2 * 2                     => 400

# decimals may omit the leading zero
.5                          => 0.5
.5 + .5                     => 1
0.5 + .25                   => 0.75
-.5                         => -0.5
.25 * 4                     => 1

# whole results stay exact past the 64 bit signed range
2 ^ 64                      => 18,446,744,073,709,551,616
10000000000 * 1000000000    => 10,000,000,000,000,000,000

# a moderately large decimal is not rewritten in scientific notation
1234567.5                   => 1,234,567.5
12345678 + 0.5              => 12,345,678.5
0.1 + 0.2                   => 0.3
1 / 3                       => 0.333333

# a printed value compares equal to the same value typed back in
1 mi to km == 1.609344 km   => true
100 pounds to kg == 45.359237 kg      => true
1 acre to m*m == 4046.8564224 m*m     => true

# shifts act on a 64 bit integer
1 << 62                     => 4,611,686,018,427,387,904
1 << 64                     => !error Shift count out of range
1 << 200                    => !error Shift count out of range
1 << -1                     => !error Shift count out of range
1 << 99999999999            => !error Shift count out of range

# bitwise operands are truncated toward zero, both sides
1.5 & 3                     => 1
7.9 | 8                     => 15
2.5 << 2                    => 8
10.9 >> 1                   => 5
-1.5 & 3                    => 3
1.5 << 1.9                  => 2

# shifts and bitwise ops are not capped to 32 bits
1 << 31                     => 2,147,483,648
1 << 32                     => 4,294,967,296
1 << 40                     => 1,099,511,627,776
1 << 62                     => 4,611,686,018,427,387,904
3000000000 % 7              => 4
5000000001 & 1              => 1
3000000000 | 0              => 3,000,000,000

# percentages work as plain operands, not only through 'of'
200 * 50%                   => 100
50% * 200                   => 100
10% * 10                    => 1

# '+' and '-' take the percentage of the left operand
100 + 10%                   => 110
100 - 10%                   => 90
200 + 25%                   => 250

# each percentage applies to the running total
150 + 10% + 10%             => 181.5
150 - 10% - 10%             => 121.5
100 + 10% - 5               => 105
1000 - 25%                  => 750

# arithmetic strips the percentage, parentheses do not
150 + (10% + 10%)           => 150.2
150 + 10% * 2               => 150.2
150 + (10%)                 => 165
10% + 100                   => 100.1
50% + 50%                   => 1
50% of 50% of 100           => 25

# '%' is modulo when an operand follows it, spacing settles the '+' and '-' case
10%3                        => 1
5%2                         => 1
100 % 5                     => 0
7 % -3                      => 1
100% - 5                    => -4

# signs
2 - -2                      => 4
-2 * -2                     => 4
3 * -2                      => -6
10 / -2                     => -5
-10 / -2                    => 5
-(-(-5))                    => -5
0 - 5                       => -5
2 - - -2                    => 0

# zero
0 * 5                       => 0
5 * 0                       => 0
0 / 5                       => 0
5 - 5                       => 0
1.5 - 1.5                   => 0
-0                          => 0

# min/max
min(3)                      => 3
max(3)                      => 3
min(1, 2, 3)                => 1
max(1, 2, 3, 4, 5)          => 5
min(-1, -2)                 => -2
max(-1.5, -2.5)             => -1.5
min(2 * 3, 4 + 1)           => 5
max(2 ^ 3, 3 ^ 2)           => 9
min()                       => !error

# whitespace does not matter around '^' either
2^(3)                       => 8
2^(2+1)                     => 8
27^(1/3)                    => 3
2^-1                        => 0.5

# word aliases for the arithmetic operators
2 add 3                     => 5
2 plus 3                    => 5
10 minus 4                  => 6
10 minus 4 plus 2           => 8
2 add 3 mul 4               => 14
2 plus 3 pow 2              => 11

# uppercase base prefixes
0X1F                        => 31
0B101                       => 5
0O17                        => 15

# thousand separators anywhere between digits
1_0_0_0                     => 1,000
0x1_F                       => 31
1_000.5 + 0_5               => 1,005.5

# a base literal stops at the first character that is not a digit in its base
0b12                        => 1
0b13                        => 1
0o7                         => 7
0xG                         => 0g
0x1G                        => 1g
0xFF.5                      => 255

# a magnitude past what a long long holds saturates rather than wrapping
2^63 to hex                 => 0x7fffffffffffffff
1e30 to hex                 => 0x7fffffffffffffff
2^63 to octal               => 0o777777777777777777777
-1e30 to hex                => -0x8000000000000000
-2^63 to hex                => -0x8000000000000000
1e30 & 1                    => 1

# shifts by and of edge values
1 << 0                      => 1
5 >> 0                      => 5
0 << 5                      => 0
-1 >> 1                     => -1
-8 >> 2                     => -2
-1 & 255                    => 255
-1 | 0                      => -1
6 & 3 | 1                   => 3

# bitwise binds tighter than comparison
1 | 2 == 3                  => true
1 & 3 == 1                  => true

# output formats
255 to hexadecimal          => 0xff
-255 to hex                 => -0xff
0 to binary                 => 0b0
0xFF to hex                 => 0xff
255 to hex to binary        => 0b11111111

# a formatted base must parse back to the same value
511 to octal                => 0o777
8 to octal                  => 0o10

# repeating and terminating decimals
1 / 6                       => 0.166667
2 / 7                       => 0.285714
22 / 7                      => 3.142857
1 / 8                       => 0.125

# remaining scientific notation forms
1e+3                        => 1,000
1.5E-3                      => 0.0015
2e-0                        => 2
1e-300                      => 1e-300

# nesting and long chains
((((1 + 2) * 3) - 4) / 5)   => 1
(((((2)))))                 => 2
1 + (2 + (3 + (4 + 5)))     => 15
2 ^ 2 ^ 2 ^ 2               => 65,536
-(-(-(-(5))))               => 5

# min/max over many and computed arguments
min(1, 2, 3, 4, 5, 6, 7, 8) => 1
max(-0.0001, -0.0002)       => -0.0001
min(1e3, 2e3)               => 1,000
max(2 ^ 10, 10 ^ 3)         => 1,024
min(0.1 + 0.2, 0.3)         => 0.3

# a trailing percentage needs no gluing, nothing follows it
5 %                         => 0.05

# comparison is exact, so accumulated error is visible rather than smoothed over
0.1 + 0.2 == 0.3            => false
0.1 + 0.2 > 0.3             => true
0.3 == 0.3                  => true

# a literal still round trips against a value computed from it, because the
# lexer scales the mantissa once instead of accumulating per digit
1 mi to km == 1.609344 km   => true

1e300 / 1e299               => 10

# a percentage carries through to the unit of what it applies to
10% of 1km                  => 0.1km
200% of 1km                 => 2km
1km + 10%                   => 1.1km
1km - 10%                   => 0.9km
1 usd + 10%                 => $1.1
50% of 1 hour               => 30 min
1 km + 10% == 1.1 km        => true

# conversion binds looser than the arithmetic feeding it
1+1 to hex                  => 0x2
1 km to m == 1000           => true

# a word alias keeps the associativity of the symbol it stands for
2 pow 3 pow 2               => 512
2 ^ 2 pow 2                 => 16
5 mod 3 mod 2               => 0
2 mul 3 mul 4               => 24
100 div 10 div 5            => 2
10 minus 3 minus 2          => 5

# a literal in any base is an operand like any other
0xFF % 10                   => 5
0b1010 << 2                 => 40
0o777 & 0xFF                => 255
1e3 % 7                     => 6

# the edges of the six decimal cap, where the tiny value guard takes over
0.9999999                   => 1
1.9999999                   => 2
1.0000001                   => 1
0.0000005                   => 5e-07
0.0000004                   => 4e-07

# right associativity and overflow composing
2 ^ 2 ^ 2 ^ 2 ^ 2           => inf

# a closed group is unaffected, at any depth
(1 + 2)                     => 3
((1+1)/2)*2                 => 2
(2 + 3) * (4 - 6) / 2       => -5

# thousand separators (only outside functions)
1,000,000                   => 1,000,000
1,2,3,4                     => 1,234
1,2,3,4.12345               => 1,234.12345
1,200*2                     => 2,400
5,000min / 2 to minutes     => 2,500min

# ** == pow
2 ** 8                      => 256
2**8                        => 256
2*2**8                      => 512
2**8*2                      => 512
2**8 == pow(2, 8)           => true

# handle 'k' postfix for thousands
100k == 100,000             => true
1k                          => 1,000
1.5k+1k+2k                  => 4,500
1500+1k+2000                => 4,500
(150*2+50)k                 => 350,000
