# ambiguous numeric date resolves day-first (DD/MM/YYYY)
11/08/2025                  => 2025-08-11 00:00:00 (Etc/UTC)

# slashes with spaces around them are division, not a date
2001 / 1 / 18               => 111.166667

# two adjacent numbers are never a date, whatever their values: a natural date
# literal needs a month name. they concatenate as one spaced number instead
0 9                         => 9
0 12                        => 12
2001 5                      => 20,015
5 2001                      => 52,001
32 5                        => 325
100 3                       => 1,003

# with a month name they parse, against a frozen "now" of 2026-01-18
18 Jan                      => 2026-01-18 00:00:00 (Etc/UTC)
Jan 18                      => 2026-01-18 00:00:00 (Etc/UTC)
18 Jan 2021                 => 2021-01-18 00:00:00 (Etc/UTC)
Jan 18 2021                 => 2021-01-18 00:00:00 (Etc/UTC)
Jan 2021                    => 2021-01-01 00:00:00 (Etc/UTC)

# 'm' means minutes when converting to seconds, not meters
1m to s                     => 60s

# 'pounds' is mass or gbp depending on the conversion target
100 pounds to kg            => 45.359237kg
1 pounds to usd             => !error No conversion rate available for gbp.

# exact alias wins before prefix decomposition: min is never milli-inch,
# mi is mile (not mebi), mb stays megabyte (not millibit)
1 min to s                  => 60s
1 mi to km                  => 1.609344km
1 mb to b                   => 1,000,000B

# a token that is a unit by itself is never reinterpreted as a plural:
# ms is milliseconds, not meters; mins is minutes, not milli-inches
5 ms to s                   => 0.005s
5 mins to s                 => 300s

# prefix case matters where symbols collide: m is milli, M is mega
1 mm to m                   => 0.001m
1 Mm to km                  => 1,000km

# 'in' is a conversion operator between units, a unit name elsewhere
1m in in                    => 39.370079in

# adjacent digit + constant is implicit multiplication
2pi                         => 6.283185
pi2                         => 6.283185

# 'e' is an exponent marker only when digits follow it, and euler's constant
# otherwise. this is the one place scientific notation and the constant collide
1e3                         => 1,000
1e                          => 2.718282
2e                          => 5.436564
e2                          => 5.436564
1e-3                        => 0.001
1e - 3                      => -0.281718

# only two names in the table match more than one unit: 'm' is a meter or a
# minute, 'pound' is a mass or gbp. everything else that looks ambiguous is
# settled by exact aliases winning over prefix decomposition.

# an operator whose operands must share a dimension resolves the token by
# matching its sibling
1m + 30s                    => 1 min 30 sec
1m to s                     => 60s
1m to in                    => 39.370079in
100 pounds to kg            => 45.359237kg

# multiplication and division compose rather than convert, so a sibling cannot
# settle anything and the token falls back to its first reading in the table
1m / 1s                     => 1m/s
60m / 1s                    => 60m/s
1m * 2                      => 2m
1m * 1s                     => 1m·s

# the same ambiguous token on both sides has no sibling to settle it and no
# conversion to perform, which used to lose the reading entirely
1m * 1m                     => 1m²
1m / 1m                     => 1

# addition has nothing to resolve against either, so the token stays a bare
# label the way it does on its own
1m + 1m                     => 2m
