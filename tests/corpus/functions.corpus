# roots and powers
sqrt(16)                    => 4
sqrt(2)                     => 1.414214
sqrt(0)                     => 0
cbrt(27)                    => 3
cbrt(-8)                    => -2
root(27, 3)                 => 3
root(-8, 3)                 => -2
root(16, 4)                 => 2
pow(2, 10)                  => 1,024
pow(2, -1)                  => 0.5
hypot(3, 4)                 => 5
hypot(1, 2, 2)              => 3

# exponentials and logarithms
exp(0)                      => 1
exp(1)                      => 2.718282
exp2(3)                     => 8
expm1(0)                    => 0
ln(e)                       => 1
ln(1)                       => 0
log(e)                      => 1
log(8, 2)                   => 3
log(1000, 10)               => 3
log2(8)                     => 3
log10(1000)                 => 3
log10 (1000)                => 3
log1p(0)                    => 0
log(0)                      => -inf

# trigonometry, in radians
sin(0)                      => 0
sin(pi/2)                   => 1
cos(0)                      => 1
cos(pi)                     => -1
tan(0)                      => 0
asin(1) == pi/2             => true
acos(1)                     => 0
atan(1) * 4                 => 3.141593
atan2(1, 1) * 4             => 3.141593
atan2(0, -1)                => 3.141593
sinh(0)                     => 0
cosh(0)                     => 1
tanh(0)                     => 0
asinh(0)                    => 0
acosh(1)                    => 0
atanh(0)                    => 0

# rounding
floor(2.7)                  => 2
floor(-2.7)                 => -3
ceil(2.1)                   => 3
ceil(-2.1)                  => -2
trunc(2.7)                  => 2
trunc(-2.7)                 => -2
round(2.4)                  => 2
round(2.5)                  => 3
round(-2.5)                 => -3
round(3.14159, 2)           => 3.14
round(1234, -2)             => 1,200
abs(-3)                     => 3
abs(3)                      => 3
sign(-5)                    => -1
sign(0)                     => 0
sign(5)                     => 1
sgn(-2.5)                   => -1

# integer functions
gcd(12, 18)                 => 6
gcd(12, 18, 8)              => 2
gcd(-12, 18)                => 6
gcd(0, 0)                   => 0
gcd(7)                      => 7
lcm(4, 6)                   => 12
lcm(2, 3, 4)                => 12
lcm(0, 5)                   => 0
fact(0)                     => 1
fact(5)                     => 120
factorial(10)               => 3,628,800
fact(170)                   => 7.257416e+306
fact(171)                   => inf
fact(2.5)                   => 3.323351

# special functions
gamma(5)                    => 24
gamma(0.5) ^ 2              => 3.141593
lgamma(5)                   => 3.178054
erf(0)                      => 0
erf(1)                      => 0.842701
erfc(0)                     => 1
fmod(7, 3)                  => 1
fmod(-7, 3)                 => -1
fmod(7.5, 2)                => 1.5

# aggregates
sum(1)                      => 1
sum(1, 2, 3)                => 6
sum(0.1, 0.2)               => 0.3
avg(1, 2, 3, 4)             => 2.5
mean(2, 4)                  => 3
average(10, 20)             => 15

# composition
sqrt(2 * 8) + 1             => 5
2 * sqrt(4)                 => 4
sqrt(4) ^ 2                 => 4
sqrt(sqrt(16))              => 2
max(sqrt(16), cbrt(27))     => 4
sqrt(4) to hex              => 0x2
round(sqrt(2), 3)           => 1.414
sqrt(25%)                   => 0.5

# rounding acts on the percentage as written
round(12.345%)              => 0.12
round(12.345%, 1)           => 0.123
abs(-50%)                   => 0.5

# domain errors
sqrt(-1)                    => !error sqrt: result is undefined
asin(2)                     => !error asin: result is undefined
acosh(0)                    => !error acosh: result is undefined
fact(-1)                    => !error fact: result is undefined
gamma(-1)                   => !error gamma: result is undefined

# arity
sqrt()                      => !error sqrt: expected 1 argument, got 0
sqrt(1, 2)                  => !error sqrt: expected 1 argument, got 2
atan2(1)                    => !error atan2: expected 2 arguments, got 1
log(8, 2, 3)                => !error log: expected 1 to 2 arguments, got 3
sum()                       => !error sum: expected at least 1 argument, got 0
gcd()                       => !error gcd: expected at least 1 argument, got 0

# argument types
sqrt(now)                   => !error sqrt: argument 1 must be a number, got DateTime
abs(1 == 1)                 => !error abs: argument 1 must be a number, got Boolean
gcd(1.5, 2)                 => !error gcd: argument 1 must be an integer, got 1.5
round(2.5, 1.5)             => !error round: argument 2 must be an integer, got 1.5
gcd(1e19, 2)                => !error gcd: argument 1 is too large

# root of degree n
nrt(9, 2)					=> 3
nrt(27, 3)					=> 3
nrt(128, 7)					=> 2
nrt(256, 8)					=> 2
nrt(2, 1)					=> 2

# finance: rate of return on investment
rri(2, 100, 121)            => 0.1
rri(10, 100, 200)           => 0.071773
rri(1, 100, 50)             => -0.5
rri(5, 100, 100)            => 0
RRI(2, 100, 121)            => 0.1
rri(2, 100)                 => !error rri: expected at least 3 arguments, got 2

# finance: effective annual rate
effect(0.1, 1)              => 0.1
effect(0.05, 12)            => 0.051162
effect(0.12, 4)             => 0.125509
effect(5%, 12)              => 0.051162
EFFECT(0.1, 2)              => 0.1025
effect(0.05)                => !error effect: expected at least 2 arguments, got 1

# finance: nominal annual rate
nominal(0.1, 1)             => 0.1
nominal(0.21, 2)            => 0.2
nominal(0.125509, 4)        => 0.12
nominal(effect(0.05, 12), 12) => 0.05
Nominal(0.1025, 2)          => 0.1
nominal(0.05)               => !error nominal: expected at least 2 arguments, got 1
