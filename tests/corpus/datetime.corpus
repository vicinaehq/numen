# "now" is frozen to 2026-01-18 00:00:00 UTC by the test harness

# times
2:42:21                     => 2026-01-18 02:42:21 (Etc/UTC)
2:42:21 + 1hour             => 2026-01-18 03:42:21 (Etc/UTC)

# numeric dates
18/01/2001                  => 2001-01-18 00:00:00 (Etc/UTC)
2001/01/18                  => 2001-01-18 00:00:00 (Etc/UTC)
01/18/2001                  => 2001-01-18 00:00:00 (Etc/UTC)
18/01/2001 13:30:15         => 2001-01-18 13:30:15 (Etc/UTC)

# time can go before date as well
5:00 18/01/2001             => 2001-01-18 05:00:00 (Etc/UTC)
5am 18/01/2001              => 2001-01-18 05:00:00 (Etc/UTC)
5am 18 jan 2001             => 2001-01-18 05:00:00 (Etc/UTC)
5am jan 2001                => 2001-01-01 05:00:00 (Etc/UTC)
5:30:45 18 jan 2001         => 2001-01-18 05:30:45 (Etc/UTC)
5:30:45pm 18 jan 2001       => 2001-01-18 17:30:45 (Etc/UTC)
march 3rd 5:30:45pm         => 2026-03-03 17:30:45 (Etc/UTC)
march 3rd at 5:30:45pm      => 2026-03-03 17:30:45 (Etc/UTC)
3rd, march 2025             => 2025-03-03 00:00:00 (Etc/UTC)
march, 3rd, 2025            => 2025-03-03 00:00:00 (Etc/UTC)
march, 3rd, 2025 5pm        => 2025-03-03 17:00:00 (Etc/UTC)

Jan 1st 2026                => 2026-01-01 00:00:00 (Etc/UTC)
Jan 15th 2026               => 2026-01-15 00:00:00 (Etc/UTC)
Jan 3rd 2026                => 2026-01-03 00:00:00 (Etc/UTC)
Feb 3rd 2026                => 2026-02-03 00:00:00 (Etc/UTC)
3rd of Feb                  => 2026-02-03 00:00:00 (Etc/UTC)
15th Jan                    => 2026-01-15 00:00:00 (Etc/UTC)

# with dashes as a separator
01-18-2001                  => 2001-01-18 00:00:00 (Etc/UTC)

# month names, in every order
18 Jan 2001                 => 2001-01-18 00:00:00 (Etc/UTC)
18 January 2001             => 2001-01-18 00:00:00 (Etc/UTC)
18 january 2001             => 2001-01-18 00:00:00 (Etc/UTC)
Jan 18 2025                 => 2025-01-18 00:00:00 (Etc/UTC)
2025 Jan 18                 => 2025-01-18 00:00:00 (Etc/UTC)
March 18 2025               => 2025-03-18 00:00:00 (Etc/UTC)
# very cursed, but hey...
Jan 2025 18                 => 2025-01-18 00:00:00 (Etc/UTC)
Jan 2025                    => 2025-01-01 00:00:00 (Etc/UTC)
2025 Jan                    => 2025-01-01 00:00:00 (Etc/UTC)
Jan 18                      => 2026-01-18 00:00:00 (Etc/UTC)
January 18                  => 2026-01-18 00:00:00 (Etc/UTC)

# 12 hr support
Jan 2025 18 7:32 am         => 2025-01-18 07:32:00 (Etc/UTC)
Jan 2025 18 7:32 pm         => 2025-01-18 19:32:00 (Etc/UTC)
Jan 2025 18 7 pm            => 2025-01-18 19:00:00 (Etc/UTC)
9 am                        => 2026-01-18 09:00:00 (Etc/UTC)
9:30 am                     => 2026-01-18 09:30:00 (Etc/UTC)
9 pm                        => 2026-01-18 21:00:00 (Etc/UTC)
9:30 pm                     => 2026-01-18 21:30:00 (Etc/UTC)

13 am                       => 13
# pm can be interpreted as a unit, am is not
13 pm                       => 13pm
12 am                       => 2026-01-18 12:00:00 (Etc/UTC)
12 pm                       => 2026-01-19 00:00:00 (Etc/UTC)

# optional "at" token between date and time
Jan 2025 18 at 7 pm         => 2025-01-18 19:00:00 (Etc/UTC)

# RFC 3339 UTC
2026-01-18T14:30:00Z        => 2026-01-18 14:30:00 (Etc/UTC)

# RFC 3339 UTC with timezone
2026-01-18T14:30:00+02:00   => 2026-01-18 16:30:00 (Etc/UTC+2)
2026-01-18T14:30:00+6:42   => 2026-01-18 21:12:00 (Etc/UTC+6:42)

# an offset still being typed: a sign, or a colon, with nothing after it
2026-01-18T14:30:00+        => 2026-01-18 14:30:00 (Etc/UTC)
2026-01-18T14:30:00-        => 2026-01-18 14:30:00 (Etc/UTC)
2026-01-18T14:30:00+05      => 2026-01-18 19:30:00 (Etc/UTC+5)
2026-01-18T14:30:00+05:     => 2026-01-18 19:30:00 (Etc/UTC+5)

# a component no clock could read means it is not a timestamp
2026-01-18T14:30:60Z        => 2026-01-18 14:31:00 (Etc/UTC)
2026-01-18T80:30:00Z        => 2026-01-18 00:00:00 (Etc/UTC)

# nanoseconds run out about 292 years either side of the epoch
01/18/1700                  => 1700-01-18 00:00:00 (Etc/UTC)
01/18/1600                  => !error Date is out of the representable range
01/18/20                    => !error Date is out of the representable range

# '2' is ambiguous, so we don't parse this as a date
01-18-2                     => -19

# the same limit, reached by shifting
100 years ago               => 1926-01-18 00:00:00 (Etc/UTC)
1150 years ago              => !error Date is out of the representable range

# adding durations
18/01/2001 13:30:15 + 1d + 5min => 2001-01-19 13:35:15 (Etc/UTC)

# adding months
01/18/2001 + 4 month        => 2001-05-18 00:00:00 (Etc/UTC)
01/18/2001 + 4 months       => 2001-05-18 00:00:00 (Etc/UTC)
01/18/2001 + 4mo            => 2001-05-18 00:00:00 (Etc/UTC)

# adding years
01/18/2001 + 1 year         => 2002-01-18 00:00:00 (Etc/UTC)
01/18/2001 + 3 years        => 2004-01-18 00:00:00 (Etc/UTC)
01/18/2001 + 1yr            => 2002-01-18 00:00:00 (Etc/UTC)

# subtracting two dates produces a duratio
01/18/2001 1:00:00 - 01/18/2001 00:00:00          => 1 hr
01/18/2001 1:00:00 - 01/18/2001 00:00:00 to hours => 1h

# timezones
2001/01/18 New York         => 2001-01-18 05:00:00 (Etc/UTC)
2001/01/18 nyc              => 2001-01-18 05:00:00 (Etc/UTC)

# implicit timezone conversion
10am osaka                  => 2026-01-18 01:00:00 (Etc/UTC)
10am utc                    => 2026-01-18 10:00:00 (Etc/UTC)

# the "9" from "9pm" should not be mistaken for something else in the date
August 10 9pm               => 2026-08-10 21:00:00 (Etc/UTC)
August 10 9 pm              => 2026-08-10 21:00:00 (Etc/UTC)
August 10 2025 9 pm         => 2025-08-10 21:00:00 (Etc/UTC)
10 August 9 pm              => 2026-08-10 21:00:00 (Etc/UTC)

# GeoNames places
now to beijing              => 2026-01-18 08:00:00 (Asia/Shanghai)
now to tokyo                => 2026-01-18 09:00:00 (Asia/Tokyo)
now to japan                => 2026-01-18 09:00:00 (Asia/Tokyo)
now to munich               => 2026-01-18 01:00:00 (Europe/Berlin)
now to texas                => 2026-01-17 18:00:00 (America/Chicago)
now to california           => 2026-01-17 16:00:00 (America/Los_Angeles)
now to mumbai               => 2026-01-18 05:30:00 (Asia/Kolkata)
now in london               => 2026-01-18 00:00:00 (Europe/London)
now in ldn                  => 2026-01-18 00:00:00 (Europe/London)
now to est                  => 2026-01-17 19:00:00 (America/New_York)

# most populous wins, unless qualified
now to paris                => 2026-01-18 01:00:00 (Europe/Paris)
now to paris texas          => 2026-01-17 18:00:00 (America/Chicago)
now to paris tx             => 2026-01-17 18:00:00 (America/Chicago)
now to portland             => 2026-01-17 16:00:00 (America/Los_Angeles)
now to portland maine       => 2026-01-17 19:00:00 (America/New_York)
now to san jose costa rica  => 2026-01-17 18:00:00 (America/Costa_Rica)

# custom links > geo database > legacy tzdb links
now to washington           => 2026-01-17 19:00:00 (America/New_York)
now to washington state     => 2026-01-17 16:00:00 (America/Los_Angeles)
now to greenwich            => 2026-01-18 00:00:00 (Europe/London)

# local names, diacritics folded
now to München              => 2026-01-18 01:00:00 (Europe/Berlin)
now to munchen              => 2026-01-18 01:00:00 (Europe/Berlin)
now to Zürich               => 2026-01-18 01:00:00 (Europe/Zurich)
now to São Paulo            => 2026-01-17 21:00:00 (America/Sao_Paulo)
now to warszawa             => 2026-01-18 01:00:00 (Europe/Warsaw)
now to Москва               => 2026-01-18 03:00:00 (Europe/Moscow)
now to 東京                 => 2026-01-18 09:00:00 (Asia/Tokyo)

now to utc					=> 2026-01-18 00:00:00 (Etc/UTC)
now to gmt					=> 2026-01-18 00:00:00 (Etc/GMT)
now to utc+9                => 2026-01-18 09:00:00 (Etc/UTC+9)
now to utc+2                => 2026-01-18 02:00:00 (Etc/UTC+2)
now to utc+2                => 2026-01-18 02:00:00 (Etc/UTC+2)
now to utc-3                => 2026-01-17 21:00:00 (Etc/UTC-3)
now to utc+5:30             => 2026-01-18 05:30:00 (Etc/UTC+5:30)
now to utc-3:15             => 2026-01-17 20:45:00 (Etc/UTC-3:15)

31 Jan 2026 + 1 month       => 2026-02-28 00:00:00 (Etc/UTC)

# conversions
18 Jan 2001 to unix           => 979,776,000second
18 Jan 2001 to unix timestamp => 979,776,000second
18 Jan 2001 to unix ts to ms  => 979,776,000,000ms
18 Jan 2001 to unix to ms     => 979,776,000,000ms
18 Jan 2001 to epoch          => 979,776,000second

# relative
time now                     => 2026-01-18 00:00:00 (Etc/UTC)
now                          => 2026-01-18 00:00:00 (Etc/UTC)
time now == now              => true
tomorrow at 5pm              => 2026-01-19 17:00:00 (Etc/UTC)
5pm tomorrow                 => 2026-01-19 17:00:00 (Etc/UTC)
at 5pm tomorrow              => 2026-01-19 17:00:00 (Etc/UTC)
yesterday at 5pm             => 2026-01-17 17:00:00 (Etc/UTC)
2 months ago at 5pm          => 2025-11-18 17:00:00 (Etc/UTC)
2 years 1 month ago at 5:30  => 2023-12-18 05:30:00 (Etc/UTC)
1 month ago                  => 2025-12-18 00:00:00 (Etc/UTC)
3 weeks ago                  => 2025-12-28 00:00:00 (Etc/UTC)
1 year ago + 1yr             => 2026-01-18 00:00:00 (Etc/UTC)
1 year 3 months 2d 50s ago   => 2024-10-15 23:59:10 (Etc/UTC)

yesterday                    => 2026-01-17 00:00:00 (Etc/UTC)
tomorrow                     => 2026-01-19 00:00:00 (Etc/UTC)
tomorrow - yesterday to days => 2d
150 years ago                => 1876-01-18 00:00:00 (Etc/UTC)

# <tz><relative> || <relative><tz>
time washington               => 2026-01-17 19:00:00 (America/New_York)
washington time               => 2026-01-17 19:00:00 (America/New_York)
washington time to washington => 2026-01-17 19:00:00 (America/New_York)

# "h" names the hour unit as well as separating a clock time. on its own it
# only reads as a clock when glued to its minutes, so "12h" is twelve hours.
# this used to split at 24 instead: "23 h" was 11pm and "24 h" a day
14h30                        => 2026-01-18 14:30:00 (Etc/UTC)
12h40                        => 2026-01-18 12:40:00 (Etc/UTC)
0h05                         => 2026-01-18 00:05:00 (Etc/UTC)

12h                          => 12 hr
14h                          => 14 hr
2h                           => 2 hr
23h                          => 23 hr
24h                          => 1 day
25h                          => 1 day 1 hr
99h                          => 4 days 3 hr

2 h                          => 2 hr
23 h                         => 23 hr
24 h                         => 1 day
2 h + 30 min                 => 2 hr 30 min
12h + 30 min                 => 12 hr 30 min
14h to min                   => 840min
1 h * 3                      => 3 hr

# the 'min' at the end should make it a duration and not a time of the day (date time)
1h30min						=> 1 hr 30 min
1h30min50s                  => 1 hr 30 min 50 sec

# after a date there is nothing else it could be, so the minutes are optional
18 Jan 2026 12h              => 2026-01-18 12:00:00 (Etc/UTC)
18 Jan 2026 12h40            => 2026-01-18 12:40:00 (Etc/UTC)

# the colon form is unambiguous and needs none of this
12:40                        => 2026-01-18 12:40:00 (Etc/UTC)

# a datetime only converts to a timezone, a format, or the epoch
now to km                    => !error Cannot convert a DateTime to km

# known bugs
jan 18th 09:00 - jan 20th 10:00 to hours	=> 49h

# until expr
until 2026-01-18 01:00:00					=> 1 hr
until 2026-01-19 02:00:00					=> 1 day 2 hr
until 2026-02-23 00:00:00					=> 1 month 5 days
until dec 25								=> 11 months 1 week
until 5 am									=> 5 hr
time until 5 am								=> 5 hr
seconds until 5 am to hours					=> 5h
